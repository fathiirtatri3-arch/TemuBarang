AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deteksi Data Pribadi Otomatis (OCR + deteksi wajah)
PII_DETECTION_ENABLED=true
TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"

# ── Masa Klaim Barang Temuan ──────────────────────────────────────
# Lama masa klaim barang temuan (hari) sejak barang masuk kantor kelurahan.
CLAIM_WINDOW_DAYS=30
# Seberapa hari sebelum masa klaim habis, admin & penemu diberi peringatan.
CLAIM_EXPIRY_REMINDER_DAYS=5
# Kalau admin tidak menindaklanjuti laporan kedaluwarsa selama N hari, super admin diberi tahu (0 = mati).
CLAIM_ESCALATION_DAYS=7
# Setelah barang dilepas, hapus data sensitif (foto asli, IMEI, ciri rahasia).
PURGE_SENSITIVE_ON_RELEASE=true
# Minimal jumlah saksi yang wajib tercatat pada berita acara.
MINIMUM_WITNESSES=1
